@model BookingStepViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    var destinations = ViewBag.AllDestinations as List<TravelSpot> ?? [];
    var requiresDestinationSelection = ViewBag.RequiresDestinationSelection as bool? ?? false;
    ViewData["Title"] = requiresDestinationSelection ? "Choose Your Destination" : $"Book {Model.Data.DestinationName}";
    var minDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var defaultDate = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
    var profileSummary = Model.Preferences is null
        ? "Traveler profile pending. Complete the preference survey for sharper recommendations."
        : $"{Model.Preferences.BudgetRange}, {Model.Preferences.TravelPace} pace, adventure {Model.Preferences.AdventureLevel}/5";
    var selectedSpot = destinations.FirstOrDefault(spot => spot.Id.ToString() == Model.Data.DestinationId);
    var bookingImageUrl = selectedSpot is null
        ? ResolveImageUrl(Model.Data.ImageUrl, "/images/hero-bg.jpg")
        : DestinationImageUrl(selectedSpot);
}

@functions {
    private string DestinationImageUrl(TravelSpot spot)
    {
        if (IsUsableImage(spot.ImageUrl, out var imageUrl))
        {
            return Url.Content(imageUrl);
        }

        var numberedImage = $"/images/{spot.Id}.jpg";
        if (ImageExists(numberedImage))
        {
            return Url.Content(numberedImage);
        }

        return ResolveImageUrl(null, CategoryFallbackImage(spot.Category));
    }

    private string AccommodationImageUrl(BookingAccommodationOption stay)
    {
        return ResolveImageUrl(stay.ImageUrl, "/images/421.jpg");
    }

    private string ResolveImageUrl(string? candidate, string fallbackImage)
    {
        if (IsUsableImage(candidate, out var imageUrl))
        {
            return Url.Content(imageUrl);
        }

        return Url.Content(ImageExists(fallbackImage) ? fallbackImage : "/images/hero-bg.jpg");
    }

    private bool IsUsableImage(string? candidate, out string imageUrl)
    {
        imageUrl = string.Empty;
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return false;
        }

        if (candidate.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            candidate.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = candidate;
            return true;
        }

        var relativeUrl = candidate.StartsWith("/") ? candidate : $"/{candidate.TrimStart('~', '/')}";
        if (!ImageExists(relativeUrl))
        {
            return false;
        }

        imageUrl = relativeUrl;
        return true;
    }

    private bool ImageExists(string relativeUrl)
    {
        var relativePath = relativeUrl.TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar);
        var physicalPath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, relativePath);
        return System.IO.File.Exists(physicalPath);
    }

    private static string CategoryFallbackImage(string? category)
    {
        return category switch
        {
            "Beach" => "/images/151.jpg",
            "Island" => "/images/153.jpg",
            "Waterfall" => "/images/51.jpg",
            "Mountain" or "Viewpoint" => "/images/301.jpg",
            "Wildlife" or "Diving" or "Marine Sanctuary" => "/images/401.jpg",
            "Religious" => "/images/2.jpg",
            "Historical" or "Monument" or "Landmark" => "/images/1.jpg",
            "Museum" => "/images/15.jpg",
            "Garden" or "Farm" => "/images/6.jpg",
            "Park" or "Nature Park" => "/images/12.jpg",
            "Theme Park" or "Water Park" or "Adventure" => "/images/23.jpg",
            "Resort" or "Hotel" => "/images/421.jpg",
            "Market" => "/images/21.jpg",
            "Shopping" or "Urban" => "/images/17.jpg",
            "Restaurant" => "/images/423.jpg",
            "Cafe" => "/images/22.jpg",
            _ => "/images/hero-bg.jpg"
        };
    }
}

<section class="booking-flow @(requiresDestinationSelection ? "booking-flow--choose-destination" : "")" data-booking-wizard data-destination-id="@Model.Data.DestinationId" data-booking-type="@Model.BookingType" data-destination="@Model.Data.DestinationName" data-base-price="@Model.Data.BasePrice" data-image-url="@Model.Data.ImageUrl" data-location="@Model.Data.Location">
    @Html.AntiForgeryToken()

    <div class="booking-shell">
        <header class="booking-hero lp-reveal">
            <div class="booking-hero__grid">
                <div>
                    @if (Model.BookingType == "SystemSelected")
                    {
                        <p class="lp-kicker">AI-Curated Experience ✨</p>
                        <p class="sg-caption sg-mb-xs">Based on your profile: @profileSummary</p>
                    }
                    else
                    {
                        <p class="lp-kicker">@(requiresDestinationSelection ? "Manual Explorer" : "Secure Flashpacker Experience")</p>
                    }
                    <h1>@(requiresDestinationSelection ? "Choose your Cebu destination" : Model.Data.DestinationName)</h1>
                    <p>@(requiresDestinationSelection ? "Pick a destination first, then customize your date, stay, transport, activities, and payment." : Model.Data.Description)</p>

                    @if (requiresDestinationSelection)
                    {
                        <div style="margin-top: 20px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                            <img src="/images/hero-bg.jpg" alt="Cebu Adventure" style="width: 100%; height: 250px; object-fit: cover;" />
                        </div>
                    }

                    <div class="bundle-switcher">
                        <a href="/Booking/ResolveAiDestination" class="bundle-btn @(Model.BookingType == "SystemSelected" ? "is-active" : "")">
                            <strong>System-Selected</strong>
                            <small>AI-curated recommendations</small>
                        </a>
                        <a href="#user-selected-modal" class="bundle-btn @(Model.BookingType == "UserSelected" ? "is-active" : "")" data-modal-open>
                            <strong>User-Selected</strong>
                            <small>Manual destination pick</small>
                        </a>
                    </div>
                </div>
                @if (!requiresDestinationSelection)
                {
                <aside class="booking-summary" aria-label="Destination overview">
                    <img class="booking-summary__image" src="@bookingImageUrl" alt="@Model.Data.DestinationName" loading="eager" onerror="this.onerror=null;this.src='@Url.Content("/images/hero-bg.jpg")';" />
                    <span>@Model.Data.RatingSummary</span>
                    <strong>PHP @Model.Data.BasePrice.ToString("N0")</strong>
                    <small>@Model.Data.Location · @Model.Data.Duration</small>
                    <small>Best time: @Model.Data.BestTimeToVisit</small>
                </aside>
                }
            </div>
        </header>

        <div id="user-selected-modal" class="booking-modal" hidden>
            <div class="booking-modal__content">
                <header>
                    <h3>Choose your next adventure</h3>
                    <button type="button" data-modal-close>&times;</button>
                </header>
                <div class="destination-grid">
                    @if (destinations.Count > 0)
                    {
                        foreach (var spot in destinations)
                        {
                            <a href="/Booking/Index?spotId=@spot.Id&type=UserSelected" class="dest-card">
                                <img src="@DestinationImageUrl(spot)" alt="@spot.Name" loading="lazy" onerror="this.onerror=null;this.src='@Url.Content("/images/hero-bg.jpg")';" />
                                <div>
                                    <strong>@spot.Name</strong>
                                    <small>@spot.Location</small>
                                    <small>From PHP @spot.BasePrice.ToString("N0")</small>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No destinations are available right now.</p>
                    }
                </div>
            </div>
        </div>

        @if (requiresDestinationSelection)
        {
            <section class="manual-destination-panel lp-reveal" aria-label="Manual destination selection">
                <div class="manual-destination-panel__header">
                    <div>
                        <p class="lp-kicker">Manual Explorer</p>
                        <h2>Select a destination to continue</h2>
                    </div>
                    <a href="/Booking/ResolveAiDestination" class="booking-link-btn">Let AI pick instead</a>
                </div>
                <div class="destination-grid">
                    @if (destinations.Count > 0)
                    {
                        foreach (var spot in destinations)
                        {
                            <a href="/Booking/Index?spotId=@spot.Id&type=UserSelected" class="dest-card">
                                <img src="@DestinationImageUrl(spot)" alt="@spot.Name" loading="lazy" onerror="this.onerror=null;this.src='@Url.Content("/images/hero-bg.jpg")';" />
                                <div>
                                    <strong>@spot.Name</strong>
                                    <small>@spot.Location</small>
                                    <small>@spot.Category - From PHP @spot.BasePrice.ToString("N0")</small>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No destinations are available right now.</p>
                    }
                </div>
            </section>
        }

        <nav class="booking-progress lp-reveal" aria-label="Booking progress">
            <span class="is-active" data-step-indicator="config">1. Customize</span>
            <span data-step-indicator="review">2. Review</span>
            <span data-step-indicator="payment">3. Payment</span>
            <span data-step-indicator="success">4. Get Pass</span>
        </nav>

        <section class="booking-stage is-active" data-booking-step="config">
            <div class="journey-layout">
                <main class="journey-timeline" aria-label="Booking options">
                    <article class="journey-item" data-timeline-step="date">
                        <div class="journey-item__pin"><span>1</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>When are you going?</span><strong>Weather-synced</strong></div>
                            <div class="booking-form-grid">
                                <label>
                                    <span>Travel date</span>
                                    <input type="date" name="travelDate" value="@defaultDate" min="@minDate" required />
                                </label>
                                <label>
                                    <span>Who's joining?</span>
                                    <select name="travelerType">
                                        <option value="Solo" data-count="1">Solo Flashpacker</option>
                                        <option value="Couple" data-count="2">Dynamic Duo</option>
                                        <option value="Group" data-count="4">Experience Group</option>
                                        <option value="Family" data-count="4">Modern Family</option>
                                    </select>
                                </label>
                            </div>
                        </div>
                    </article>

                    <article class="journey-item" data-timeline-step="activities">
                        <div class="journey-item__pin"><span>2</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Experience-driven activities</span><strong>Curated for you</strong></div>
                            <div class="booking-option-list">
                                @foreach (var activity in Model.ActivityOptions)
                                {
                                    <label class="booking-choice">
                                        <input type="checkbox" name="activities" value="@activity.Name" data-price="@activity.Price" />
                                        <span>
                                            <strong>@activity.Name</strong>
                                            <small>@activity.Description</small>
                                        </span>
                                        <b>+PHP @activity.Price.ToString("N0")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item" data-timeline-step="stay">
                        <div class="journey-item__pin"><span>3</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Flashpacker Stays</span><strong>Budget meets Comfort</strong></div>
                            <div class="booking-option-list booking-option-list--media">
                                @foreach (var stay in Model.AccommodationOptions)
                                {
                                    <label class="booking-choice booking-choice--media">
                                        <input type="radio" name="accommodation" value="@stay.Name" data-price="@stay.PricePerNight" @(stay.PricePerNight == 0 ? "checked" : null) />
                                        <img src="@AccommodationImageUrl(stay)" alt="@stay.Name" loading="lazy" onerror="this.onerror=null;this.src='@Url.Content("/images/421.jpg")';" />
                                        <span>
                                            <strong>@stay.Name</strong>
                                            <small>@stay.Type · @stay.Amenities</small>
                                        </span>
                                        <b>@(stay.PricePerNight == 0 ? "Included" : $"+PHP {stay.PricePerNight:N0}")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item" data-timeline-step="transport">
                        <div class="journey-item__pin"><span>4</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Flexible Transport</span><strong>Efficiency first</strong></div>
                            <div class="booking-option-list">
                                @foreach (var transport in Model.TransportOptions)
                                {
                                    <label class="booking-choice">
                                        <input type="radio" name="transportation" value="@transport.Name" data-price="@transport.Price" @(transport.Price == 0 ? "checked" : null) />
                                        <span>
                                            <strong>@transport.Name</strong>
                                            <small>@transport.Details</small>
                                        </span>
                                        <b>@(transport.Price == 0 ? "Included" : $"+PHP {transport.Price:N0}")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item" data-timeline-step="notes">
                        <div class="journey-item__pin"><span>5</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Final details</span><strong>Anything else?</strong></div>
                            <label class="booking-notes">
                                <textarea name="travelerNotes" rows="3" placeholder="Dietary needs, special occasions, or transport preferences..."></textarea>
                            </label>
                            <div class="journey-item__actions">
                                <button type="button" class="booking-primary" data-goto-step="review">Review Trip Summary</button>
                            </div>
                        </div>
                    </article>
                </main>

                <aside class="checkout-panel lp-reveal">
                    <h2>Live Estimate</h2>
                    <dl>
                        <div><dt>Base Trip</dt><dd>PHP <span data-base-display>@Model.Data.BasePrice.ToString("N0")</span></dd></div>
                        <div data-add-ons-row hidden><dt>Add-ons</dt><dd>PHP <span data-addons-display>0</span></dd></div>
                        <div><dt>Vat (12%)</dt><dd>PHP <span data-taxes-display>0</span></dd></div>
                        <div class="total-row"><dt>Total</dt><dd>PHP <span data-total-display>@Model.Data.BasePrice.ToString("N0")</span></dd></div>
                    </dl>
                    <div class="smart-rec-box">
                        <p><strong>Flashpacker Tip:</strong> @Model.SmartRecommendations.FirstOrDefault()</p>
                    </div>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="review">
            <div class="journey-layout">
                <main class="flash-checkout__form">
                    <h2>Trip Summary</h2>
                    <div class="review-summary" data-review-summary></div>
                    <div class="journey-item__actions">
                        <button type="button" class="booking-link-btn" data-goto-step="config">Edit Details</button>
                        <button type="button" class="booking-primary" data-goto-step="payment">Secure Payment</button>
                    </div>
                </main>
                <aside class="checkout-panel">
                    <h2>Route Explorer</h2>
                    <div class="booking-map">
                        <iframe title="@Model.Data.DestinationName map" src="@Model.Data.MapUrl" loading="lazy"></iframe>
                    </div>
                    <p class="small text-muted">Your itinerary is synced to our local guides instantly upon confirmation.</p>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="payment">
            <div class="checkout-composer">
                <main class="checkout-composer__form">
                    <p class="lp-kicker">Checkout</p>
                    <h2>Payment details</h2>
                    <p class="checkout-copy">Saved checkout references are reused on your next booking and can be edited from Profile.</p>

                    <div class="checkout-section-title">Traveler & payment</div>
                    <div class="checkout-grid checkout-grid--two">
                        <input type="text" id="checkout-first-name" placeholder="First Name" value="@Model.Data.CheckoutFirstName" autocomplete="given-name" required />
                        <input type="text" id="checkout-last-name" placeholder="Last Name" value="@Model.Data.CheckoutLastName" autocomplete="family-name" required />
                    </div>
                    <input type="text" id="checkout-address" placeholder="Address Line 1" value="@Model.Data.CheckoutAddressLine1" autocomplete="address-line1" required />
                    <div class="checkout-grid checkout-grid--three">
                        <input type="text" id="checkout-city" placeholder="City" value="@Model.Data.CheckoutCity" autocomplete="address-level2" required />
                        <input type="text" id="checkout-state" placeholder="State/Province" value="@Model.Data.CheckoutStateProvince" autocomplete="address-level1" required />
                        <input type="text" id="checkout-postal" placeholder="ZIP/Postal Code" value="@Model.Data.CheckoutPostalCode" autocomplete="postal-code" required />
                    </div>
                    <input type="email" id="checkout-email" placeholder="Email Address" value="@Model.Data.CheckoutEmailAddress" autocomplete="email" required />

                    <div class="checkout-divider"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.Data.CardLast4))
                    {
                        <div class="saved-payment-reference">
                            <strong>Saved reference</strong>
                            <span>@Model.Data.PaymentMethod ending @Model.Data.CardLast4</span>
                        </div>
                    }

                    <div class="checkout-grid checkout-grid--card">
                        <input type="text" id="card-number" placeholder="Card Number" maxlength="19" autocomplete="cc-number" data-saved-last4="@Model.Data.CardLast4" />
                        <input type="text" id="card-expiry" placeholder="MM/YY" maxlength="5" value="@Model.Data.CardExpiry" autocomplete="cc-exp" required />
                        <input type="password" id="card-cvv" placeholder="CVV" maxlength="4" autocomplete="cc-csc" required />
                    </div>
                    <input type="text" id="card-name" placeholder="Name on Card" value="@Model.Data.CardholderName" autocomplete="cc-name" required />

                    <label class="checkout-save-reference">
                        <input type="checkbox" id="save-checkout-reference" checked />
                        <span>Save this checkout reference to my profile</span>
                    </label>

                    <div class="checkout-actions">
                        <button type="button" class="booking-link-btn" data-goto-step="review">Back</button>
                        <button type="button" class="booking-primary" id="btn-submit-booking" disabled>Complete Booking & Pay</button>
                    </div>

                    <div class="payment-sim" data-payment-sim hidden>
                        <div class="spinner"></div>
                        <p>Processing secure payment...</p>
                    </div>
                </main>
                <aside class="checkout-order-summary">
                    <h2>Order Summary</h2>
                    <div class="checkout-order-summary__item">
                        <img src="@Model.Data.ImageUrl" alt="@Model.Data.DestinationName" />
                        <div>
                            <strong>@Model.Data.DestinationName</strong>
                            <span>Quantity: <span data-summary-quantity>@Model.Data.TravelerCount</span></span>
                        </div>
                        <b>PHP <span data-summary-base>@Model.Data.BasePrice.ToString("N0")</span></b>
                    </div>
                    <dl>
                        <div><dt>Subtotal:</dt><dd>PHP <span data-summary-subtotal>@Model.Data.BasePrice.ToString("N0")</span></dd></div>
                        <div><dt>Add-ons:</dt><dd>PHP <span data-summary-addons>0</span></dd></div>
                        <div><dt>Tax:</dt><dd>PHP <span data-summary-tax>0</span></dd></div>
                    </dl>
                    <div class="checkout-order-summary__total">
                        <span>Total:</span>
                        <strong>PHP <span data-summary-total>@Model.Data.BasePrice.ToString("N0")</span></strong>
                    </div>
                    <button type="button" class="checkout-edit-cart" data-goto-step="config">Edit Trip</button>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="success">
            <div class="success-state">
                <header class="success-state__header">
                    <p class="lp-kicker">Success!</p>
                    <h2>Pack your bags, @(User.Identity?.Name?.Split(' ')[0] ?? "Traveler").</h2>
                </header>
                
                <div class="digital-pass">
                    <div class="digital-pass__header">
                        <span>Digital Pass</span>
                        <strong>SUGBOGO</strong>
                    </div>
                    <div class="digital-pass__body">
                        <div class="review-item"><strong>ID</strong><span data-conf-id>---</span></div>
                        <div class="review-item"><strong>Destination</strong><span>@Model.Data.DestinationName</span></div>
                        <div class="review-item"><strong>Status</strong><span class="text-success">Confirmed</span></div>
                    </div>
                    <div class="digital-pass__footer">
                        <div class="qr-preview" data-qr-code-placeholder></div>
                        <p class="small text-muted mt-2">Scan at destination for instant check-in</p>
                    </div>
                </div>

                <div class="journey-item__actions">
                    <a href="/Dashboard" class="booking-primary">View Trip in Dashboard</a>
                </div>
            </div>
        </section>
    </div>
</section>
