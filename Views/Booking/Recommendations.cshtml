@model TravelRecommendationsViewModel

@{
    ViewData["Title"] = "AI Cebu Recommendations";
}

<section class="recommendation-flow">
    <div class="recommendation-shell">
        <header class="recommendation-hero lp-reveal">
            <div>
                <p class="lp-kicker">Step 3 of 3</p>
                <h1>Your best Cebu matches.</h1>
                <p>Ranked from your saved places (@string.Join(", ", Model.Preferences.PlaceInterests)) and activities (@string.Join(", ", Model.Preferences.ActivityInterests)).</p>
            </div>
            <a class="booking-link-btn" asp-controller="Booking" asp-action="Survey">Update preferences</a>
        </header>

        <div class="recommendation-grid">
            @foreach (var item in Model.Recommendations)
            {
                <article class="recommendation-card lp-reveal">
                    <img src="@item.Destination.ImageUrl" alt="@item.Destination.Name in @item.Destination.Location" />
                    <div class="recommendation-card__body">
                        <div class="recommendation-card__score">
                            <span>@item.MatchScore% match</span>
                            <small>@item.Destination.Location</small>
                        </div>
                        <h2>@item.Destination.Name</h2>
                        <p>@item.Destination.Summary</p>
                        <div class="recommendation-tags">
                            @foreach (var category in item.Destination.Categories)
                            {
                                <span>@category</span>
                            }
                        </div>
                        <strong>@item.Reason</strong>
                        <div class="recommendation-card__actions">
                            <a href="/Booking/Index?spotId=@item.Destination.Id&type=UserSelected" class="booking-primary">Book this trip</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <section class="ai-explainer lp-reveal" aria-labelledby="ai-title">
            <div class="ai-explainer__head">
                <p class="lp-kicker">How the AI recommendation system works</p>
                <h2 id="ai-title">Transparent now, smarter over time.</h2>
            </div>

            <div class="ai-explainer__grid">
                @foreach (var step in Model.Explanation)
                {
                    <article>
                        <h3>@step.Title</h3>
                        <p>@step.Body</p>
                    </article>
                }
            </div>

            <div class="tech-stack">
                <h3>Suggested implementation stack</h3>
                <p><strong>Authentication:</strong> Google OAuth or Supabase Auth with Google provider, storing only the user ID, email, and profile metadata needed for booking.</p>
                <p><strong>Cloud database:</strong> Supabase Postgres with row-level security, encrypted connection strings, and separate tables for users, travel preferences, destinations, feedback, and booking events.</p>
                <p><strong>AI tools:</strong> OpenAI embeddings for semantic matching, GPT models for natural-language itinerary explanations, and a deterministic scoring layer for auditable ranking.</p>
                <p><strong>APIs:</strong> Google Places API for place metadata, Maps/Routes API for travel time, Stripe or PayMongo for payments, and Supabase Edge Functions or ASP.NET services for secure recommendation calls.</p>
            </div>
        </section>
    </div>
</section>
