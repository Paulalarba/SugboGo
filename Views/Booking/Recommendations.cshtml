@model TravelRecommendationsViewModel

@{
    ViewData["Title"] = "AI Cebu Recommendations";
}

<style>
    .match-bar-wrap {
        margin: 6px 0 10px;
    }

    .match-bar-track {
        height: 6px;
        border-radius: 3px;
        background: var(--lp-line);
        overflow: hidden;
    }

    .match-bar-fill {
        height: 100%;
        border-radius: 3px;
        background: var(--lp-blue);
        transition: width 0.6s ease;
    }

    .match-score-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--lp-blue);
    }
</style>

<section class="recommendation-flow">
    <div class="recommendation-shell">
        <header class="recommendation-hero lp-reveal">
            <div>
                <p class="lp-kicker">AI Recommendations · Step 3 of 4</p>
                <h1>Your best Cebu matches.</h1>
                <p>
                    Ranked from your interests in
                    <strong>@string.Join(", ", Model.Preferences.PlaceInterests)</strong>
                    and activities like
                    <strong>@string.Join(", ", Model.Preferences.ActivityInterests)</strong>.
                    Your selected adventure level is <strong>@Model.Preferences.AdventureLevel/5</strong>. Pick one to book.
                </p>
            </div>
            <a class="booking-link-btn" asp-controller="Booking" asp-action="Survey">Update preferences</a>
        </header>

        <div class="recommendation-grid">
            @foreach (var item in Model.Recommendations)
            {
                <article class="recommendation-card lp-reveal">
                    <img src="@item.Destination.ImageUrl" alt="@item.Destination.Name in @item.Destination.Location" />
                    <div class="recommendation-card__body">
                        <div class="recommendation-card__score">
                            <small>Adventure level @item.Destination.AdventureLevel/5</small>   
                        </div>
                        <h2>@item.Destination.Name</h2>

                        <div class="match-bar-wrap">
                            <div class="match-score-label">
                                <span>AI Match</span>
                                <span>@item.MatchScore%</span>
                            </div>
                            <div class="match-bar-track">
                                <div class="match-bar-fill" style="width:@(item.MatchScore)%"></div>
                            </div>
                        </div>

                        <p>@item.Destination.Summary</p>

                        <div class="recommendation-tags">
                            @foreach (var category in item.Destination.Categories)
                            {
                                <span>@category</span>
                            }
                        </div>

                        <strong>@item.Reason</strong>

                        <div class="recommendation-card__actions">
                            <a href="/Booking/Index?spotId=@item.Destination.Id&type=SystemSelected" class="booking-primary">Book this trip</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <section class="ai-explainer lp-reveal" aria-labelledby="ai-title">
            <div class="ai-explainer__head">
                <p class="lp-kicker">How the AI recommendation system works</p>
                <h2 id="ai-title">Transparent now, smarter over time.</h2>
            </div>
            <div class="ai-explainer__grid">
                @foreach (var step in Model.Explanation)
                {
                    <article>
                        <h3>@step.Title</h3>
                        <p>@step.Body</p>
                    </article>
                }
            </div>
        </section>
    </div>
</section>