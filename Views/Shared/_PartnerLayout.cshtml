<!DOCTYPE html><html lang="en"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SugboGo Partner | @ViewData["Title"]</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/sugbogo.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    
    <style>
        :root {
            --admin-bg: #F0F4F2;         /* Fresh soft greenish-grey background */
            --admin-surface: #E8EDE9;    /* Lighter surface */
            --admin-border: #D1D9D4;     /* Subtle borders */
            --admin-text-main: #1E2824;  
            --admin-text-muted: #5C6661; 
            --admin-accent: #0A443A;     
            --admin-accent-light: #DEE5E1;
            
            --admin-success: #144527;
            --admin-warning: #87550B;
            --admin-danger: #822222;
        }

        body.admin-portal {
            background: var(--admin-bg);
            color: var(--admin-text-main);
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 260px;
            background: var(--admin-surface);
            border-right: 1px solid var(--admin-border);
            display: flex; 
            flex-direction: column;
            position: sticky; 
            top: 0; 
            height: 100vh;
            box-sizing: border-box;
            padding: 24px 16px;
        }

        .admin-brand {
            padding: 12px 16px 32px 16px;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem; 
            font-weight: 700;
            color: var(--admin-accent);
            letter-spacing: -0.5px;
            line-height: 1.1;
        }
        .admin-brand span {
            display: block;
            font-size: 0.7rem;
            font-family: 'DM Sans', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--admin-text-muted);
            margin-top: 4px;
            font-weight: 600;
        }

        .admin-nav { 
            flex: 1; 
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        
        .admin-nav a, .logout-nav-btn {
            display: flex;
            align-items: center; 
            gap: 14px;
            padding: 12px 16px; 
            color: var(--admin-text-muted);
            text-decoration: none; 
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background: transparent;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }
        
        .admin-nav a:hover, .logout-nav-btn:hover {
            background: var(--admin-accent-light);
            color: var(--admin-accent);
        }
        
        .admin-nav a.is-active {
            background: var(--admin-accent-light);
            color: var(--admin-accent);
            font-weight: 600;
            border-left: 3px solid var(--admin-accent);
            border-radius: 0 8px 8px 0;
            padding-left: 13px;
        }

        .sidebar-footer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
            border-top: 1px solid var(--admin-border);
            padding-top: 16px;
        }

        .admin-layout-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        .admin-top-bar {
            height: 70px;
            background: var(--admin-bg);
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            flex-shrink: 0;
        }

        .top-bar-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--admin-accent);
        }

        .top-bar-actions {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .top-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--admin-border);
        }

        .profile-dropdown-card {
            display: none;
            position: absolute;
            right: 0;
            top: 46px;
            background: white;
            border: 1px solid var(--admin-border);
            border-radius: 12px;
            width: 220px;
            box-shadow: 0 8px 24px rgba(29, 42, 38, 0.08);
            z-index: 1000;
            padding: 12px;
            box-sizing: border-box;
        }
        .profile-dropdown-card.is-open { display: block; }
        .dropdown-user-info { display: flex; flex-direction: column; padding: 4px 8px 8px 8px; }
        .dropdown-user-info strong { font-size: 0.9rem; color: var(--admin-text-main); }
        .dropdown-user-info span { font-size: 0.75rem; color: var(--admin-text-muted); }

        .admin-main { flex: 1; padding: 40px; overflow-y: auto; }
        .admin-main h1 { font-family: 'Cormorant Garamond', serif; color: var(--admin-text-main); }
        
        .admin-section {
            background: white;
            border: 1px solid var(--admin-border);
            border-radius: 12px; 
            margin-bottom: 32px; 
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.02);
        }
        .section-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--admin-border);
            display: flex; justify-content: space-between; align-items: center;
        }
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th {
            text-align: left; padding: 14px 24px;
            background: #FAFAFA;
            font-size: 0.75rem; text-transform: uppercase; color: var(--admin-text-muted);
            letter-spacing: 0.5px;
        }
        .admin-table td { padding: 18px 24px; border-top: 1px solid var(--admin-border); font-size: 0.9rem; color: var(--admin-text-main); }
        
        .status-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 10px;
        }
        .status--pending { background: #FEF7EA; color: var(--admin-warning); }
        .status--confirmed, .status--paid, .status--completed { background: #EBF5EE; color: var(--admin-success); }
        .status--in-progress { background: #E8F0FE; color: #1A73E8; }
        .status--cancelled { background: #FDF2F2; color: var(--admin-danger); }
    </style>
    @await RenderSectionAsync("Styles", required: false)</head><body class="admin-portal">

    <aside class="admin-sidebar">
        <div class="admin-brand">
            SugboGo
            <span>Partner Network</span>
        </div>
        
        <nav class="admin-nav">
            <a asp-controller="Partner" asp-action="Index" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "is-active" : "")">
                <i class="bi bi-grid"></i> Overview
            </a>
            <a asp-controller="Partner" asp-action="Bookings" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Bookings" ? "is-active" : "")">
                <i class="bi bi-calendar-check"></i> Assignments
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; width: 100%;">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-nav-btn">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-layout-container">
        <header class="admin-top-bar">
            <div class="top-bar-title">@ViewData["Title"]</div>
            <div class="top-bar-actions">
                <div style="position: relative; display: inline-block;">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop&crop=faces" 
                         class="top-avatar" id="profileMenuTrigger" alt="Profile" style="cursor: pointer;" />
                         
                    <div class="profile-dropdown-card" id="profileDropdownMenu">
                        <div class="dropdown-user-info">
                            <strong>@User.Identity?.Name</strong>
                            <span>Partner Representative</span>
                        </div>
                        <hr style="border: 0; border-top: 1px solid var(--admin-border); margin: 8px 0;" />
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; padding: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="width: 100%; border: none; background: transparent; padding: 8px; text-align: left; cursor: pointer;">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const trigger = document.getElementById("profileMenuTrigger");
            const menu = document.getElementById("profileDropdownMenu");
            if (trigger && menu) {
                trigger.addEventListener("click", () => menu.classList.toggle("is-open"));
                document.addEventListener("click", (e) => { if (!menu.contains(e.target) && e.target !== trigger) menu.classList.remove("is-open"); });
            }
        });
    </script>
</body></html>