<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SugboGo</title>
    
    <meta name="description" content="SugboGo curates hidden gems, authentic local spots, tailored Cebu itineraries, and partner developer earning opportunities." />
    <meta property="og:title" content="SugboGo: Explore Cebu, Curated" />
    <meta property="og:description" content="Where flashpackers discover hidden gems, vetted local partners, and one-click Cebu itineraries." />
    
    <!-- Google Fonts: existing Cebu pages use Cormorant + DM Sans; landing page adds Poppins + Libre Baskerville -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;600&family=Libre+Baskerville:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Main Stylesheet (sugbogo.css only - no site.css needed) -->
    <link rel="stylesheet" href="~/css/sugbogo.css" asp-append-version="true" />
</head>

<body data-authenticated="@User.Identity?.IsAuthenticated.ToString().ToLowerInvariant()">
    <!-- ================================================== -->
    <!-- SG-NAV: Modern navbar from sugbogo.css              -->
    <!-- ================================================== -->
    <header class="sg-nav">
        <div class="sg-container sg-nav__inner">
            <a href="/" class="sg-nav__logo">Sugbo<span>Go</span></a>
            
            @if (User.IsInRole("Admin"))
            {
                <nav class="sg-nav__links">
                    <a href="/Admin">Admin Dashboard</a>
                    <a href="/Admin#travelers">Manage Users</a>
                    <a href="/Admin#bookings">All Bookings</a>
                </nav>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="sg-nav__links">
                    <a href="/Booking/Survey">Booking</a>
                    <a href="/Dashboard">Dashboard</a>
                    <a href="/Booking/Survey">Profile</a>
                </nav>
            }
            else
            {
                <nav class="sg-nav__links">
                    <a href="/">Dashboard</a>
                    <a href="/Booking/Start">Booking</a>
                    <a href="/#experiences">Experiences</a>
                    <div class="sg-nav__dropdown">
                        <button class="sg-nav__dropdown-toggle" type="button">How It Works ▾</button>
                        <div class="sg-nav__dropdown-menu">
                            <a href="/#why">Why SugboGo</a>
                            <a href="/#partners">For Developers</a>
                        </div>
                    </div>
                </nav>
            }

            <div class="sg-nav__actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="sg-nav__user">Hi, @(User.Identity.Name?.Split(' ')[0] ?? "User")</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sg-nav__logout" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button class="sg-btn sg-btn--outline sg-btn--sm" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="sg-btn sg-btn--outline sg-btn--sm" href="/Account">Login</a>
                    <a class="sg-btn sg-btn--primary sg-btn--sm" href="/Booking/Start">Book now</a>
                }
            </div>
        </div>
    </header>

    <!-- MAIN DYNAMIC CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- ================================================== -->
    <!-- SG-FOOTER: Rich footer from sugbogo.css             -->
    <!-- ================================================== -->
    <footer class="sg-footer">
        <div class="sg-container">
            <div class="sg-footer__inner">
                <div class="sg-footer__brand">
                    <a href="/" class="sg-nav__logo">Sugbo<span>Go</span></a>
                    <p class="sg-footer__tagline">Where Flashpackers Discover Hidden Gems</p>
                </div>
                <div class="sg-footer__col">
                    <div class="sg-footer__col-title">Product</div>
                    <ul class="sg-footer__links">
                        <li><a href="/#experiences">Explore Experiences</a></li>
                        <li><a href="/#how">How It Works</a></li>
                        <li><a href="/#why">Our Story</a></li>
                    </ul>
                </div>
                <div class="sg-footer__col">
                    <div class="sg-footer__col-title">For Developers</div>
                    <ul class="sg-footer__links">
                        <li><a href="/#partners">Partner Program</a></li>
                        <li><a href="https://developer.sogbogo.com">API Documentation</a></li>
                        <li><a href="/#partners">Developer Blog</a></li>
                    </ul>
                </div>
                <div class="sg-footer__col">
                    <div class="sg-footer__col-title">Stay Updated</div>
                    <ul class="sg-footer__links">
                        <li><a href="mailto:hello@sugbogo.com">hello@sugbogo.com</a></li>
                        <li><a href="/#faq">FAQ</a></li>
                        <li><a href="/Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="sg-footer__bottom">
                <div class="sg-footer__copy">© @DateTime.Now.Year SogboGo. Explore Cebu like a local.</div>
                <div class="sg-footer__socials">
                    <a href="#" class="sg-footer__social-link">IG</a>
                    <a href="#" class="sg-footer__social-link">FB</a>
                    <a href="#" class="sg-footer__social-link">IN</a>
                    <a href="#" class="sg-footer__social-link">TT</a>
                </div>
            </div>
        </div>
    </footer>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
