<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SugboGo Admin | @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/sugbogo.css" asp-append-version="true" />
    <style>
        :root {
            --admin-bg: #0d1117;
            --admin-surface: #161b22;
            --admin-border: #30363d;
            --admin-text: #c9d1d9;
            --admin-accent: #58a6ff;
            --admin-success: #238636;
            --admin-warning: #d29922;
            --admin-danger: #da3633;
        }

        body.admin-portal {
            background: var(--admin-bg);
            color: var(--admin-text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            margin: 0;
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 260px;
            background: var(--admin-surface);
            border-right: 1px solid var(--admin-border);
            display: flex; flex-direction: column;
            position: sticky; top: 0; height: 100vh;
        }

        .admin-brand {
            padding: 24px;
            font-size: 1.5rem; font-weight: 800;
            color: var(--admin-accent); letter-spacing: -1px;
            display: flex; align-items: center; gap: 12px;
        }

        .admin-nav { flex: 1; padding: 12px; }
        .admin-nav a {
            display: flex;
            align-items: center; gap: 12px;
            padding: 12px 16px; color: var(--admin-text);
            text-decoration: none; border-radius: 6px;
            margin-bottom: 4px; transition: 0.2s;
        }
        .admin-nav a:hover, .admin-nav a.is-active {
            background: rgba(88, 166, 255, 0.1);
            color: var(--admin-accent);
        }

        .admin-main { flex: 1; padding: 32px; overflow-y: auto; }
        
        /* Shared components for all Admin pages */
        .admin-section {
            background: var(--admin-surface);
            border: 1px solid var(--admin-border);
            border-radius: 8px; margin-bottom: 32px; overflow: hidden;
        }
        .section-header {
            padding: 16px 24px;
            border-bottom: 1px solid var(--admin-border);
            display: flex; justify-content: space-between; align-items: center;
        }
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th {
            text-align: left; padding: 12px 24px;
            background: rgba(255, 255, 255, 0.02);
            font-size: 0.75rem; text-transform: uppercase; color: #8b949e;
        }
        .admin-table td { padding: 16px 24px; border-top: 1px solid var(--admin-border); font-size: 0.9rem; }
        .status-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            background: rgba(88, 166, 255, 0.12);
            color: var(--admin-accent);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            text-transform: capitalize;
        }
        .status--pending, .status--curating, .status--awaiting-approval {
            background: rgba(210, 153, 34, 0.15);
            color: var(--admin-warning);
        }
        .status--confirmed, .status--paid, .status--completed {
            background: rgba(35, 134, 54, 0.15);
            color: var(--admin-success);
        }
        .status--in-progress {
            background: rgba(88, 166, 255, 0.15);
            color: var(--admin-accent);
        }
        .status--cancelled, .status--failed {
            background: rgba(218, 54, 51, 0.15);
            color: var(--admin-danger);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-portal">
    <aside class="admin-sidebar">
        <div class="admin-brand"><span style="font-size: 1.8rem;">🚀</span> SugboGo Admin</div>
        <nav class="admin-nav">
            <a asp-controller="Admin" asp-action="Index" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "is-active" : "")">Dashboard</a>
            <a href="/Admin#bookings">Bookings</a>
            <a href="/Admin#travelers">Travelers</a>
            <a href="/Admin#gems">Hidden Gems</a>
            <a href="/Admin#partners">Partners</a>
 
            <div style="margin-top: 32px; padding: 12px 16px; font-size: 0.7rem; color: #8b949e; text-transform: uppercase; letter-spacing: 0.1em;">System</div>
            <a href="/Admin#system">Settings</a>
            <a asp-controller="Home" asp-action="Index">Back to Site</a>
        </nav>
        <div style="padding: 24px; border-top: 1px solid var(--admin-border);">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 32px; height: 32px; background: var(--admin-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white;">A</div>
                <div>
                    <div style="font-size: 0.85rem; font-weight: 600;">@User.Identity?.Name</div>
                    <div style="font-size: 0.7rem; color: #8b949e;">Master Curator</div>
                </div>
            </div>
        </div>
    </aside>

    <main class="admin-main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
