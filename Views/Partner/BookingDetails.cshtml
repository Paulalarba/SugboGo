@model SugboGo.Models.BookingAdminViewModel
@{
    Layout = "_PartnerLayout";
    string StatusClass(string status) => string.IsNullOrWhiteSpace(status) ? "status--pending" : $"status--{status.Trim().ToLowerInvariant().Replace(" ", "-")}";
}

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
        margin-top: 32px;
    }
    .card {
        background: white;
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
    }
    .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--admin-border);
        padding-bottom: 12px;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 0.95rem;
    }
    .info-label { color: var(--admin-text-muted); font-weight: 500; }
    .info-value { font-weight: 600; text-align: right; }
    
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    
    .itinerary-item {
        padding: 12px;
        border-left: 3px solid var(--admin-accent);
        background: var(--admin-bg);
        margin-bottom: 12px;
        border-radius: 0 6px 6px 0;
    }
    
    .btn-status {
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        border: none;
        margin-top: 16px;
        font-family: inherit;
        transition: 0.2s;
    }
    .btn-status--primary { background: var(--admin-accent); color: white; }
    .btn-status--primary:hover { opacity: 0.9; }
</style>

<div style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <a asp-action="Bookings" style="color: var(--admin-text-muted); text-decoration: none; font-size: 0.9rem; font-weight: 600;">
            <i class="bi bi-arrow-left"></i> Back to Ledger
        </a>
        <h1 style="margin: 8px 0 0 0; font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; font-weight: 700;">
            Itinerary #@Model.Id.Substring(0, 8).ToUpper()
        </h1>
    </div>
    <div style="text-align: right;">
        <span class="status-badge @StatusClass(Model.Status)" style="font-size: 1rem; padding: 8px 16px;">@Model.Status</span>
    </div>
</div>

<div class="details-grid">
    <div class="main-content">
        <div class="card">
            <div class="card-title">Traveler Information</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
                <div>
                    <div class="info-row"><span class="info-label">Name</span><span class="info-value">@Model.UserName</span></div>
                    <div class="info-row"><span class="info-label">Group Size</span><span class="info-value">@Model.TravelerCount Pax</span></div>
                </div>
                <div>
                    <div class="info-row"><span class="info-label">Destination</span><span class="info-value">@Model.Destination</span></div>
                    <div class="info-row"><span class="info-label">Date</span><span class="info-value">@Model.Date</span></div>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.TravelerNotes))
            {
                <div style="margin-top: 24px; padding: 16px; background: #FFF8E1; border-radius: 8px; border: 1px solid #FFE082;">
                    <span style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #795548; margin-bottom: 4px;">Special Request:</span>
                    <p style="margin: 0; font-style: italic;">"@Model.TravelerNotes"</p>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-title">Service Components</div>
            <div class="itinerary-item">
                <div style="font-weight: 700;">Transportation</div>
                <div style="font-size: 0.9rem; color: var(--admin-text-muted);">@Model.SelectedTransport</div>
            </div>
            <div class="itinerary-item">
                <div style="font-weight: 700;">Accommodation</div>
                <div style="font-size: 0.9rem; color: var(--admin-text-muted);">@Model.SelectedAccommodation</div>
            </div>
            <div class="itinerary-item">
                <div style="font-weight: 700;">Planned Activities</div>
                <ul style="margin: 8px 0 0 0; padding-left: 20px; font-size: 0.9rem;">
                    @foreach (var activity in Model.SelectedActivities)
                    {
                        <li>@activity</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="sidebar">
        <div class="card" style="border-color: var(--admin-accent); background: #f0f7f5;">
            <div class="card-title">Operational Status</div>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Id" />
                
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted);">Update Progress</label>
                    <select name="status" class="btn-status" style="background: white; border: 1px solid var(--admin-border); text-align: left; padding-left: 12px;">
                        <option value="Confirmed" selected="@(Model.Status == "Confirmed" ? "selected" : null)">Confirmed (Awaiting Trip)</option>
                        <option value="In Progress" selected="@(Model.Status == "In Progress" ? "selected" : null)">Trip In Progress</option>
                        <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Trip Completed</option>
                    </select>
                </div>

                <button type="submit" class="btn-status btn-status--primary">Save Trip Status</button>
            </form>
        </div>
        
        <div class="card">
            <div class="card-title">Internal QR Registry</div>
            <div style="text-align: center; padding: 20px; background: var(--admin-bg); border-radius: 8px;">
                <div style="font-size: 1.5rem; font-weight: 700; font-family: monospace; letter-spacing: 4px;">@Model.QrCode</div>
                <p style="margin: 12px 0 0 0; font-size: 0.75rem; color: var(--admin-text-muted);">SCAN TO VERIFY TRAVELER</p>
            </div>
        </div>
    </div>
</div>