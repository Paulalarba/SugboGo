@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Command Center Overview";
    Layout = "_AdminLayout";

    static string StatusClass(string status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "status--pending"
            : $"status--{status.Trim().ToLowerInvariant().Replace(" ", "-")}";
    }
}

<header id="dashboard" class="admin-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px;">
    <div>
        <p style="color: #8b949e; margin: 0 0 4px 0; font-size: 0.9rem;">Welcome back,</p>
        <h1 style="margin: 0; font-size: 1.8rem; font-weight: 700;">Command Center Overview</h1>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="sg-btn" type="button" style="background: var(--admin-surface); border: 1px solid var(--admin-border); color: white; padding: 8px 16px; border-radius: 6px;">Export Data</button>
        <button class="sg-btn" type="button" style="background: var(--admin-accent); color: white; border: none; padding: 8px 16px; border-radius: 6px;">Generate Report</button>
    </div>
</header>

<div class="kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 32px;">
    @foreach (var kpi in Model.Kpis)
    {
        <div class="kpi-card" style="background: var(--admin-surface); border: 1px solid var(--admin-border); padding: 24px; border-radius: 8px;">
            <label style="font-size: 0.85rem; color: #8b949e; display: block; margin-bottom: 8px;">@kpi.Label</label>
            <strong style="font-size: 2rem; display: block; margin-bottom: 4px;">@kpi.Value</strong>
            <small style="color: var(--admin-accent); font-size: 0.85rem;">@kpi.Delta</small>
        </div>
    }
</div>

<section id="bookings" class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1rem; font-weight: 600;">Recent Bookings</h2>
        <a href="#bookings" style="font-size: 0.85rem; color: var(--admin-accent); text-decoration: none;">View All</a>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Traveler</th>
                <th>Destination</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bookings.Count == 0)
            {
                <tr>
                    <td colspan="5" style="color: #8b949e;">No bookings have been submitted yet.</td>
                </tr>
            }
            else
            {
                @foreach (var booking in Model.Bookings.Take(10))
                {
                    <tr>
                        <td>@booking.UserName</td>
                        <td>@booking.Destination</td>
                        <td>@booking.Date</td>
                        <td>PHP @booking.Amount.ToString("N0")</td>
                        <td>
                            <span class="status-pill @StatusClass(booking.Status)">@booking.Status</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</section>

<section id="travelers" class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1rem; font-weight: 600;">Travelers</h2>
        <span style="font-size: 0.85rem; color: #8b949e;">@Model.Flashpackers.Count profile(s)</span>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Vibe</th>
                <th>Constraints</th>
                <th>Trips</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var traveler in Model.Flashpackers.Take(8))
            {
                <tr>
                    <td>@traveler.Name</td>
                    <td>@traveler.Vibe</td>
                    <td>@traveler.Constraints</td>
                    <td>@traveler.CebuTrips</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section id="gems" class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1rem; font-weight: 600;">Hidden Gems</h2>
        <span style="font-size: 0.85rem; color: #8b949e;">@Model.Gems.Count curated spot(s)</span>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Score</th>
                <th>Status</th>
                <th>Quality Check</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gem in Model.Gems.Take(8))
            {
                <tr>
                    <td>@gem.Name</td>
                    <td>@gem.Category</td>
                    <td>@gem.FlashpackerScore/10</td>
                    <td><span class="status-pill @StatusClass(gem.Status)">@gem.Status</span></td>
                    <td>@gem.QualityCheckDate</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section id="partners" class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1rem; font-weight: 600;">Partners</h2>
        <span style="font-size: 0.85rem; color: #8b949e;">@Model.Partners.Count partner(s)</span>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Contact</th>
                <th>Commission</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partner in Model.Partners.Take(8))
            {
                <tr>
                    <td>@partner.Name</td>
                    <td>@partner.Type</td>
                    <td>@partner.Contact</td>
                    <td>@partner.Commission</td>
                    <td><span class="status-pill @StatusClass(partner.Status)">@partner.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section id="system" class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1rem; font-weight: 600;">System</h2>
    </div>
    <div style="padding: 20px 24px; color: #8b949e; font-size: 0.9rem;">
        Dashboard data is populated from registered users, travel preferences, bookings, destination posts, and the configured admin data store.
    </div>
</section>
