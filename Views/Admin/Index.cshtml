@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Command Center Overview";
    Layout = "_AdminLayout";
    
    // Fallback counts for metrics calculation if your ViewModel properties contain list data
    int totalUsers = Model.Flashpackers?.Count ?? 0;
    int liveBookings = Model.Bookings?.Count ?? 0;
    int pendingItineraries = Model.Bookings?.Count(b => b.Status?.ToLower() == "pending" || b.Status?.ToLower() == "curating") ?? 0;
    
    // Summarize gross revenue numbers from your existing Bookings data array
    decimal totalRevenue = Model.Bookings?.Sum(b => b.Amount) ?? 0;
}

<style>
    /* Global Section Framework Layout elements */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 36px;
    }
    .dashboard-header h1 { margin: 0; font-size: 2.2rem; font-weight: 700; letter-spacing: -0.5px; }
    .dashboard-header p { margin: 0 0 6px 0; color: var(--admin-text-muted); font-size: 0.95rem; }

    /* Urgent Action Alerts Container Box */
    .alerts-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 32px;
    }
    .alert-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #FFF5F5;
        border: 1px solid rgba(130, 34, 34, 0.2);
        padding: 14px 20px;
        border-radius: 10px;
        color: var(--admin-danger);
        font-size: 0.9rem;
        font-weight: 600;
    }
    .alert-banner i { font-size: 1.2rem; }
    .alert-banner--warning {
        background: #FFF9ED;
        border-color: rgba(135, 85, 11, 0.2);
        color: var(--admin-warning);
    }

    /* Business Intelligence Metric Cards (KPI Grid) */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 24px;
        margin-bottom: 36px;
    }
    .kpi-card {
        background: white;
        border: 1px solid var(--admin-border);
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(29, 42, 38, 0.02);
    }
    .kpi-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--admin-text-muted);
        display: block;
        margin-bottom: 12px;
        font-weight: 700;
    }
    .kpi-value {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.4rem;
        font-weight: 700;
        color: var(--admin-text-main);
        display: block;
        line-height: 1;
        margin-bottom: 6px;
    }
    .kpi-delta { font-size: 0.8rem; font-weight: 600; color: var(--admin-success); }

    /* Central Layout Viewport Splitter */
    .dashboard-main-split {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
        align-items: start;
    }

    /* Booking Velocity Chart Wrapper (Pure CSS Bars) */
    .chart-section {
        background: white;
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 12px rgba(29, 42, 38, 0.02);
    }
    .chart-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        height: 200px;
        padding-top: 24px;
        border-bottom: 1px solid var(--admin-border);
    }
    .chart-bar-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        gap: 8px;
    }
    .chart-bar {
        width: 65%;
        background: var(--admin-border);
        border-radius: 4px 4px 0 0;
        transition: background-color 0.3s, height 0.5s;
        cursor: pointer;
    }
    .chart-bar:hover, .chart-bar.is-today {
        background: var(--admin-accent);
    }
    .chart-label {
        font-size: 0.75rem;
        color: var(--admin-text-muted);
        margin-bottom: -16px;
        padding-top: 4px;
    }

    /* Right Sidebar Column Components */
    .sidebar-cards-group {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .trending-card {
        background: var(--admin-accent-light);
        border: 1px solid var(--admin-border);
        border-radius: 12px;
        padding: 24px;
    }
    .trending-tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--admin-warning);
        font-weight: 700;
        display: block;
        margin-bottom: 12px;
    }
    .trending-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 12px 0;
        color: var(--admin-accent);
    }

    .btn-action {
        width: 100%;
        padding: 10px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        background: white;
        color: var(--admin-text-main);
        border: 1px solid var(--admin-border);
        transition: 0.2s;
    }
    .btn-action:hover {
        border-color: var(--admin-accent);
        color: var(--admin-accent);
    }
</style>

<header class="dashboard-header">
    <div>
        <p>Welcome back, Admin</p>
        <h1>Command Center Overview</h1>
    </div>
</header>

<div class="alerts-container">
    @if (pendingItineraries > 0)
    {
        <div class="alert-banner">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Urgent Action Required: You have <strong>@pendingItineraries</strong> tailor-made itineraries awaiting curation or client confirmation.</span>
        </div>
    }
    <div class="alert-banner alert-banner--warning">
        <i class="bi bi-hourglass-split"></i>
        <span>Vendor Operations Notice: 2 local partner payouts are processing and awaiting clearance for dispatch.</span>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-label">Total Users</span>
        <strong class="kpi-value">@totalUsers</strong>
        <small class="kpi-delta"><i class="bi bi-graph-up"></i> Active platform explorers</small>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Live Bookings</span>
        <strong class="kpi-value">@liveBookings</strong>
        <small class="kpi-delta"><i class="bi bi-arrow-up-right"></i> Active reservation itineraries</small>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Pending Curation</span>
        <strong class="kpi-value">@pendingItineraries</strong>
        <small class="kpi-delta" style="color: var(--admin-warning);"><i class="bi bi-clock"></i> Requires attention</small>
    </div>
    <div class="kpi-card">
        <span class="kpi-label">Gross Revenue</span>
        <strong class="kpi-value">₱@totalRevenue.ToString("N0")</strong>
        <small class="kpi-delta"><i class="bi bi-currency-exchange"></i> Tracked in PHP currency</small>
    </div>
</div>

<div class="dashboard-main-split">
    
    <section class="chart-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h2 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--admin-text-main);">Booking Velocity</h2>
            <span style="font-size: 0.8rem; color: var(--admin-text-muted); font-weight: 600;">Last 30 Days</span>
        </div>
        <p style="margin: 0 0 16px 0; font-size: 0.9rem; color: var(--admin-text-muted);">
            Your heritage tour operations are performing 12% above quarterly targets. Most bookings are centered in the Historic Cebu District today.
        </p>
        
        <div class="chart-container">
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: 35%;"></div>
                <span class="chart-label">Oct 01</span>
            </div>
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: 55%;"></div>
                <span class="chart-label">Oct 07</span>
            </div>
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: 48%;"></div>
                <span class="chart-label">Oct 14</span>
            </div>
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: 75%;"></div>
                <span class="chart-label">Oct 21</span>
            </div>
            <div class="chart-bar-wrapper">
                <div class="chart-bar is-today" style="height: 90%;"></div>
                <span class="chart-label" style="font-weight: 700; color: var(--admin-text-main);">Today</span>
            </div>
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: 25%; background: var(--admin-surface); border: 1px dashed var(--admin-border);"></div>
                <span class="chart-label" style="font-style: italic;">Forecast</span>
            </div>
        </div>
    </section>

    <div class="sidebar-cards-group">
        <aside class="trending-card">
            <span class="trending-tag">Trending Spotlight</span>
            <h3 class="trending-title">Oslob Heritage Walk</h3>
            <p style="font-size: 0.9rem; line-height: 1.5; color: var(--admin-text-main); margin-bottom: 24px;">
                Bookings for this historical walking tour increased by 45% following the feature in "Asian Heritage Monthly".
            </p>
            <button class="btn-action" onclick="window.location.hash = 'gems';" type="button">
                View Destination Details
            </button>
        </aside>
    </div>
</div>