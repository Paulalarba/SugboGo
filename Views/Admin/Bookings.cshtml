@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    string StatusClass(string status) => string.IsNullOrWhiteSpace(status) ? "status--pending" : $"status--{status.Trim().ToLowerInvariant().Replace(" ", "-")}";
}

<div style="margin-bottom: 32px;">
    <h1 style="margin: 0; font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; font-weight: 700;">Master Booking Ledger</h1>
    <p style="margin: 4px 0 0 0; color: var(--admin-text-muted);">Process traveler payments, assign local tour operations guides, and manage active curation lifecycles.</p>
</div>

<section class="admin-section">
    <div class="section-header">
        <h2 style="margin: 0; font-size: 1.1rem; font-weight: 600;">All Operations Records (@Model.Bookings.Count)</h2>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Traveler</th>
                <th>Destination</th>
                <th>Date</th>
                <th>Assigned Partner</th>
                <th>Amount</th>
                <th>Status</th>
                <th style="text-align: right;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td style="font-weight: 600;">@booking.UserName</td>
                    <td>@booking.Destination</td>
                    <td style="color: var(--admin-text-muted);">@booking.Date</td>
                    <td>
                        @if (string.IsNullOrEmpty(booking.AssignedPartnerId))
                        {
                            <span style="color: var(--admin-danger); font-size: 0.8rem; font-weight: 600;">⚠️ Unassigned</span>
                        }
                        else
                        {
                            <span style="font-size: 0.85rem; font-weight: 600;">@booking.AssignedPartnerName</span>
                        }
                    </td>
                    <td style="font-weight: 600;">PHP @booking.Amount.ToString("N0")</td>
                    <td><span class="status-pill @StatusClass(booking.Status)">@booking.Status</span></td>
                    <td style="text-align: right;"><a asp-action="BookingDetails" asp-route-id="@booking.Id" style="color: var(--admin-accent); text-decoration: none; font-weight: 600; font-size: 0.85rem;">Manage Itinerary ➔</a></td>
                </tr>
            }
        </tbody>
    </table>
</section>