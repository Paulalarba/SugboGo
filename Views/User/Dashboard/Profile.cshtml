@model DashboardViewModel

@{
    ViewData["Title"] = "Your Profile";
    var savedPreferences = Model.TravelPreferenceReference;
    var placeOptions = TravelPreferenceSeedData.PlaceOptions;
    var activityOptions = TravelPreferenceSeedData.ActivityOptions;
    var travelPaces = new[] { "Relaxed", "Balanced", "Packed" };
    var budgetRanges = new[] { "Budget", "Mid-range", "Premium" };
}

<section class="feed-page" data-profile-page>
    <header class="feed-topbar lp-reveal">
        <div>
            <p class="lp-kicker">SugboGo Explorer</p>
            <h1>Welcome, @Model.FirstName</h1>
            <p>Manage your account, view your shared stories, and track your curated Cebu gems.</p>
        </div>
        <div class="feed-topbar__actions">
            <a class="feed-profile-chip is-active" href="/Dashboard/Profile">@Model.UserInitial</a>
        </div>
    </header>

    <div class="feed-shell">
        <aside class="feed-sidebar feed-sidebar--left lp-reveal">
            <article class="feed-profile-card">
                <div class="feed-avatar feed-avatar--large">@Model.UserInitial</div>
                <h2>@Model.FirstName</h2>
                <p>@Model.TravelProfile.StayPreference</p>
                <div class="feed-profile-stats">
                    <span><strong>@Model.SocialFeed.Count</strong> posts</span>
                    <span><strong>@Model.SavedGems.Count</strong> saved</span>
                </div>
            </article>

            <article class="feed-panel">
                <h2>Quick Actions</h2>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <a href="/Booking/Survey" class="sg-btn sg-btn--outline sg-btn--sm" style="text-decoration: none; text-align: center;">Edit Travel Interests</a>
                    <a href="/Dashboard" class="sg-btn sg-btn--primary sg-btn--sm" style="text-decoration: none; text-align: center;">Back to Feed</a>
                </div>
            </article>

            <article class="feed-panel">
                <h2>Cebu Status</h2>
                <ul class="feed-capability-list">
                    <li><span></span> Verified Explorer</li>
                    <li><span></span> @Model.SocialFeed.Count Shared Stories</li>
                    <li><span></span> @Model.Bookings.Count Booked Adventures</li>
                </ul>
            </article>
        </aside>

        <main class="feed-main">
            @if (TempData["ProfileMessage"] is string message)
            {
                <div class="feed-panel feed-notice">@message</div>
            }
            @if (TempData["ProfileError"] is string error)
            {
                <div class="feed-panel feed-notice feed-notice--error">@error</div>
            }

            <section class="feed-panel lp-reveal">
                <h2>Edit Profile Info</h2>
                <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post" class="feed-form" style="display: block;">
                    @Html.AntiForgeryToken()
                    <div class="feed-form__grid">
                        <label>
                            <span>Full Name</span>
                            <input name="fullName" type="text" value="@(User.Identity?.Name ?? string.Empty)" required />
                        </label>
                        <label>
                            <span>Email Address</span>
                            <input type="email" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.Email)" disabled style="background: rgba(255,255,255,0.05); cursor: not-allowed;" />
                        </label>
                    </div>
                    <div class="feed-form__actions" style="margin-top: 1rem;">
                        <button type="submit" class="sg-btn sg-btn--primary">Save Changes</button>
                    </div>
                </form>
            </section>

            <section id="recommendation-preferences" class="feed-panel lp-reveal">
                <h2>Recommendation Preferences</h2>
                <p class="text-muted">
                    Saved to your profile and used whenever SugboGo ranks Cebu spots for you.
                    @(savedPreferences.UpdatedAt.HasValue ? $"Last updated {savedPreferences.UpdatedAt.Value.ToLocalTime():MMM d, yyyy}." : "Save once, then update anytime from here.")
                </p>
                <form asp-controller="Dashboard" asp-action="UpdateTravelPreferences" method="post" class="feed-form" style="display: block;">
                    @Html.AntiForgeryToken()
                    <div class="preference-field">
                        <span>Places of interest</span>
                        <div class="interest-grid" style="margin-top: 0.75rem;">
                            @foreach (var option in placeOptions)
                            {
                                var isChecked = savedPreferences.SelectedPlaces.Contains(option.Key, StringComparer.OrdinalIgnoreCase);
                                <label class="interest-option">
                                    <input type="checkbox" name="selectedPlaces" value="@option.Key" checked="@isChecked" />
                                    <span>
                                        <strong>@option.Label</strong>
                                        <small>@option.Description</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="preference-field" style="margin-top: 1rem;">
                        <span>Activities</span>
                        <div class="interest-grid" style="margin-top: 0.75rem;">
                            @foreach (var option in activityOptions)
                            {
                                var isChecked = savedPreferences.SelectedActivities.Contains(option.Key, StringComparer.OrdinalIgnoreCase);
                                <label class="interest-option">
                                    <input type="checkbox" name="selectedActivities" value="@option.Key" checked="@isChecked" />
                                    <span>
                                        <strong>@option.Label</strong>
                                        <small>@option.Description</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="feed-form__grid" style="margin-top: 1rem;">
                        <label>
                            <span>Travel Pace</span>
                            <select name="travelPace">
                                @foreach (var pace in travelPaces)
                                {
                                    <option value="@pace" selected="@(string.Equals(savedPreferences.TravelPace, pace, StringComparison.OrdinalIgnoreCase))">@pace</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Budget Range</span>
                            <select name="budgetRange">
                                @foreach (var budget in budgetRanges)
                                {
                                    <option value="@budget" selected="@(string.Equals(savedPreferences.BudgetRange, budget, StringComparison.OrdinalIgnoreCase))">@budget</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label style="margin-top: 1rem;">
                        <span>Adventure Level</span>
                        <input name="adventureLevel" type="range" min="1" max="5" value="@savedPreferences.AdventureLevel" />
                    </label>
                    <label style="margin-top: 1rem;">
                        <span>Notes for the curator</span>
                        <textarea name="notes" rows="3">@savedPreferences.Notes</textarea>
                    </label>
                    <div class="feed-form__actions" style="margin-top: 1rem;">
                        <button type="submit" class="sg-btn sg-btn--primary">Save Recommendation Preferences</button>
                        <a href="/Booking/Survey" class="sg-btn sg-btn--outline" style="text-decoration: none;">Open Full Setup</a>
                    </div>
                </form>
            </section>

            <section class="feed-panel lp-reveal">
                <h2>Checkout Reference</h2>
                <p class="text-muted">These details prefill your booking payment step. Only the card ending is saved.</p>
                <form asp-controller="Dashboard" asp-action="UpdateCheckoutPreference" method="post" class="feed-form" style="display: block;">
                    @Html.AntiForgeryToken()
                    <div class="feed-form__grid">
                        <label>
                            <span>First Name</span>
                            <input name="firstName" type="text" value="@Model.CheckoutPreference.FirstName" />
                        </label>
                        <label>
                            <span>Last Name</span>
                            <input name="lastName" type="text" value="@Model.CheckoutPreference.LastName" />
                        </label>
                    </div>
                    <label>
                        <span>Address Line 1</span>
                        <input name="addressLine1" type="text" value="@Model.CheckoutPreference.AddressLine1" />
                    </label>
                    <div class="feed-form__grid">
                        <label>
                            <span>City</span>
                            <input name="city" type="text" value="@Model.CheckoutPreference.City" />
                        </label>
                        <label>
                            <span>State/Province</span>
                            <input name="stateProvince" type="text" value="@Model.CheckoutPreference.StateProvince" />
                        </label>
                    </div>
                    <div class="feed-form__grid">
                        <label>
                            <span>ZIP/Postal Code</span>
                            <input name="postalCode" type="text" value="@Model.CheckoutPreference.PostalCode" />
                        </label>
                        <label>
                            <span>Email Address</span>
                            <input name="emailAddress" type="email" value="@Model.CheckoutPreference.EmailAddress" />
                        </label>
                    </div>
                    <div class="feed-form__grid">
                        <label>
                            <span>Name on Card</span>
                            <input name="cardholderName" type="text" value="@Model.CheckoutPreference.CardholderName" />
                        </label>
                        <label>
                            <span>Card Ending</span>
                            <input name="cardLast4" type="text" maxlength="4" value="@Model.CheckoutPreference.CardLast4" />
                        </label>
                    </div>
                    <div class="feed-form__grid">
                        <label>
                            <span>Expiry</span>
                            <input name="cardExpiry" type="text" maxlength="5" placeholder="MM/YY" value="@Model.CheckoutPreference.CardExpiry" />
                        </label>
                        <label>
                            <span>Payment Method</span>
                            <input name="paymentMethod" type="text" value="@Model.CheckoutPreference.PaymentMethod" />
                        </label>
                    </div>
                    <div class="feed-form__actions" style="margin-top: 1rem;">
                        <button type="submit" class="sg-btn sg-btn--primary">Save Checkout Reference</button>
                    </div>
                </form>
            </section>

            <section class="feed-list lp-reveal">
                <div class="feed-section-header" style="margin-bottom: 1.5rem;">
                    <h2>Your Shared Stories</h2>
                    <p>Posts you've shared with the SugboGo community.</p>
                </div>

                @if (!Model.SocialFeed.Any())
                {
                    <article class="feed-panel feed-empty-state">
                        <h2>No stories yet</h2>
                        <p>Your Cebu destination posts will appear here. Head over to the dashboard to share your first experience!</p>
                        <a href="/Dashboard" class="sg-btn sg-btn--outline sg-btn--sm" style="margin-top: 1rem; text-decoration: none;">Go to Dashboard</a>
                    </article>
                }

                @foreach (var post in Model.SocialFeed)
                {
                    <article class="feed-post" data-feed-post data-post-id="@post.Id">
                        <header class="feed-post__header">
                            <div class="feed-avatar">@post.AuthorInitial</div>
                            <div>
                                <strong>@post.AuthorName</strong>
                                <span>@post.AuthorRole · @post.Timestamp</span>
                            </div>
                        </header>

                        <div class="feed-post__body">
                            <div class="feed-post__title-row">
                                <div>
                                    <h2>@post.DestinationName</h2>
                                    <p>@post.Location</p>
                                </div>
                            </div>
                            <p>@post.Description</p>
                            <p class="feed-caption">@post.Caption</p>
                            <div class="feed-tags">
                                @foreach (var tag in post.Tags)
                                {
                                    <span>#@tag</span>
                                }
                            </div>
                        </div>

                        <img class="feed-post__image" src="@post.ImageUrl" alt="@post.DestinationName" />

                        <footer class="feed-engagement">
                            <div class="feed-counts">
                                <span><b>@post.Likes</b> likes</span>
                                <span><b>@post.Comments</b> comments</span>
                            </div>
                        </footer>
                    </article>
                }
            </section>
        </main>

        <aside class="feed-sidebar feed-sidebar--right lp-reveal">
            <article class="feed-panel">
                <h2>Saved Gems</h2>
                @if (Model.SavedGems.Any())
                {
                    <ul class="feed-saved-list">
                        @foreach (var gem in Model.SavedGems)
                        {
                            <li>
                                <div>
                                    <strong>@gem.Title</strong>
                                    <span>@gem.Note</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Your saved Cebu gems will appear here.</p>
                }
            </article>

            <article class="feed-panel">
                <h2>Travel Preferences</h2>
                <div class="feed-profile-details">
                    <div style="margin-bottom: 1rem;">
                        <strong>Budget</strong>
                        <p>@Model.TravelProfile.StayPreference</p>
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <strong>Interests</strong>
                        <p>@Model.TravelProfile.FoodPreference</p>
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <strong>Pace</strong>
                        <p>@Model.TravelProfile.PacePreference</p>
                    </div>
                </div>
                <a href="#recommendation-preferences" class="sg-btn sg-btn--outline sg-btn--sm" style="width: 100%; text-decoration: none; display: block; text-align: center; margin-top: 1rem;">Edit Saved Reference</a>
            </article>
        </aside>
    </div>
</section>
